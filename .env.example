# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored — never commit real keys.

# Anthropic API — powers material price retrieval
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Neon serverless Postgres — connection string from your Neon project dashboard
# https://console.neon.tech
DATABASE_URL=

# Clerk authentication — both keys from your Clerk dashboard
# https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── Estimate tuning (all optional) ───────────────────────────────────────────
# Model for the main estimate call. Defaults to the top tier.
# ESTIMATE_MODEL=

# Model for the repair pass. Defaults to whatever ESTIMATE_MODEL is.
# ESTIMATE_REPAIR_MODEL=

# Set to "false" to disable web search on the first pass. Catalog lines need no
# research; the repair pass still enables search when the sources gate fails.
# ESTIMATE_SEARCH_FIRST=

# ── Locality (all optional) ─────────────────────────────────────────────────
# Real truck-route road miles. Free key: https://openrouteservice.org/dev/#/signup
# Without it, distances are straight-line x 1.3 and labelled approximate.
# OPENROUTESERVICE_API_KEY=

# Weekly Midwest diesel and gas from the EIA API. Free key: https://www.eia.gov/opendata/
# Without it, the same price is read from EIA's public history page.
# EIA_API_KEY=

# Model for reading receipt / scale-ticket photos. Defaults to ESTIMATE_MODEL.
# SCAN_MODEL=
